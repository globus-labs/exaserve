include README.md
include pyproject.toml
include MANIFEST.in
recursive-include requirements *.lock README.md
recursive-include src/exaserve *.py
recursive-include src/exaserve/resources *.c *.Makefile *.json
include src/exaserve/py.typed

prune benchmarks
prune clientlab
prune eval
prune findings
prune plot
prune tools
exclude .codex
exclude .gitignore
exclude AGENTS.md
exclude doc/OBJECTIVES.md
exclude doc/TODO.md
exclude note.txt
