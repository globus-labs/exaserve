include README.md
include pyproject.toml
include MANIFEST.in
recursive-include src/aurora_rayserver *.py
recursive-include src/aurora_rayserver/resources *.sh *.c *.Makefile
recursive-include src/aurora_rayserver/patches/ray_serve_overlay *.py
include src/aurora_rayserver/py.typed
recursive-include tests *.py

prune benchmarks
prune clientlab
prune eval
prune findings
prune plot
prune tools
exclude .codex
exclude .gitignore
exclude AGENTS.md
exclude doc/OBJECTIVES.md
exclude doc/TODO.md
exclude note.txt
