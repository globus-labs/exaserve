{
  "study": {
    "name": "latency-capacity-map",
    "suite": "latency_capacity_map",
    "repeats": 1
  },
  "matrix": {
    "axes": [
      {
        "name": "max_active_requests",
        "path": "client.max_active_requests",
        "values": [8, 16, 32, 64]
      },
      {
        "name": "service_time_ms",
        "path": "faults.service_time.value_ms",
        "values": [1, 10, 50]
      }
    ]
  },
  "client": {
    "duration_s": 3.0,
    "rate": 80.0,
    "prompt_words": 64,
    "output_tokens": 32,
    "num_go_workers": 2,
    "num_go_procs": 1,
    "max_active_requests": 16,
    "queue_capacity": 0,
    "enable_httptrace": true,
    "phase_trace_sample_rate": 0.1
  },
  "target": {
    "type": "synthetic",
    "mode": "latency_box",
    "host": "127.0.0.1",
    "port": 18200
  },
  "faults": {
    "service_time": {
      "distribution": "fixed",
      "value_ms": 10
    }
  },
  "collectors": {
    "port_monitor": true,
    "netstats": false
  },
  "execution": {
    "mode": "local"
  }
}
