#!/bin/bash -l
# ============================================================================
# Sample PBS script that hands off to ``aurora-launch-cluster``.
#
# Most users should use ``aurora-serve-submit <config>`` instead — it
# generates and qsubs a self-contained PBS script for you. This template
# is for users who need to integrate the launcher into their own PBS
# pipeline (chained jobs, reservation queues, custom prologue, etc.).
#
# Edit the #PBS directives below to match your project / config / queue,
# then submit with simply::
#
#     qsub examples/launch.pbs
#
# (or override individual fields per-submission, e.g. ``qsub -l select=4
# -v CONFIG=examples/config.haproxy.yaml examples/launch.pbs``).
# ============================================================================

# --- PBS directives ---------------------------------------------------------
# Allocation / project — edit YOUR_PROJECT.
#PBS -A YOUR_PROJECT

# Nodes, walltime, filesystems, queue. Edit as needed.
#PBS -l select=2
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -q debug-scaling

# Job name. PBS limits this to ~15 chars on some sites.
#PBS -N aurora-serve

# Keep stdout+stderr on the execution host so they survive job rerun
# (matches what aurora-serve-submit does).
#PBS -k doe

# Where to spool stdout/stderr after the job ends. Make sure the
# directory exists before submission.
#PBS -o /home/USER/tmp/
#PBS -e /home/USER/tmp/
# ----------------------------------------------------------------------------

# -u is intentionally off: ``module load`` (lmod) references unset internal
# vars and trips ``set -u`` with "ZSH_EVAL_CONTEXT: unbound variable".
set -eo pipefail

# PBS jobs land in $HOME by default — switch to the submit dir so a
# relative CONFIG (e.g. examples/config.haproxy.yaml) resolves the way
# the user expects. Pass an absolute path via -v CONFIG=/path/... if
# you want this to work from anywhere.
cd "${PBS_O_WORKDIR:-$PWD}"

CONFIG="${CONFIG:-examples/config.haproxy.yaml}"
if [ ! -f "$CONFIG" ]; then
    echo "ERROR: CONFIG=$CONFIG not found from $(pwd). Pass -v CONFIG=<path> at qsub time." >&2
    exit 1
fi

# Aurora frameworks Python (3.12) — required for ray, vllm, mpiexec, mpicc.
# Mirror what ``aurora-serve-submit``-rendered PBS does: prefer the user's
# env_aurora script if present (sets ALCF proxy + module loads); otherwise
# fall back to a bare ``module load frameworks``.
if [ -f "$HOME/script/env_aurora" ]; then
    source "$HOME/script/env_aurora"
else
    module load frameworks
fi

# Hand off to the installed-package launcher. ``aurora-launch-cluster``
# is a console script the wheel installs; it resolves the bash launcher
# via importlib.resources so this script does not need to know where the
# package lives. Requires the wheel's bin/ on PATH (typical with
# ``pip install --user`` + Python's user-base, or a venv that's been
# activated in env_aurora).
exec aurora-launch-cluster "$CONFIG"
