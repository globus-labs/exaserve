#!/bin/bash
#
# Usage:  qsub -l select=N -q QUEUE -N NAME scripts/debug_128n.pbs
#   e.g.  qsub -l select=2  -q debug         -N debug-proxy2   scripts/debug_128n.pbs
#         qsub -l select=128 -q debug-scaling -N debug-proxy128 scripts/debug_128n.pbs
#
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -A AuroraGPT
#PBS -l place=scatter
#PBS -o /home/wenyiw/exaserve/tmp/debug-proxy.stdout
#PBS -e /home/wenyiw/exaserve/tmp/debug-proxy.stderr

# =============================================================================
# Debug job: Launch Ray cluster and diagnose ProxyActor deaths.
#
# From run3 analysis (128 nodes):
#   - Cluster forms (1536 GPUs), replicas deploy (0 deaths)
#   - ProxyActors (HTTP proxies on each node) die in a cascade
#   - Root cause: HTTP_PROXY_TIMEOUT was 60s (default), too short at scale
#   - Fix: sitecustomize.py now sets it to 600s
#   - This job tests whether the fix is sufficient
# =============================================================================

set -eo pipefail

PROJECT_ROOT="/home/wenyiw/exaserve"
DEBUG_OUT="$PROJECT_ROOT/tmp/debug_proxy_$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$DEBUG_OUT"

echo "=== DEBUG 128-NODE PROXY DIAGNOSIS ==="
echo "Time: $(date -u)"
echo "Job: $PBS_JOBID"
echo "Head: $(hostname)"
echo "Output: $DEBUG_OUT"
echo ""

# Save nodefile
sort -u "$PBS_NODEFILE" > "$DEBUG_OUT/nodes.txt"
NODE_COUNT=$(wc -l < "$DEBUG_OUT/nodes.txt")
echo "Nodes: $NODE_COUNT"

# --- Environment ---
source ~/script/env_aurora
# Unset HTTP proxy so curl can reach compute nodes directly (env_aurora sets
# http_proxy for external access, but it breaks intra-cluster health checks).
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY

# --- Write deployment config ---
cd "$PROJECT_ROOT"

# Resolve head IP
HEAD_IP=$(python3 -c "
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(('10.255.255.255', 1))
print(s.getsockname()[0])
s.close()
")
echo "Head IP: $HEAD_IP"

cat > "$DEBUG_OUT/config.yaml" <<YAML
model_deployment_config:
  collect_stats: false
  deployment_name: debug_128n
  local_stage_path: /tmp/hf_home
  model_configs:
  - enable_log_requests: false
    enforce_eager: true
    gpu_memory_utilization: 0.9
    max_model_len: 4096
    max_num_seqs: 64
    model_id: meta-llama/Meta-Llama-3-8B-Instruct
    num_cpus_per_replica: 4
    num_replicas: null
    pipeline_parallel_size: 1
    size: 8
    tensor_parallel_size: 1
  model_storage_path: /lus/flare/projects/AuroraGPT/wenyiw/models
  num_gpus_per_node: 12
  num_nodes: $NODE_COUNT
  replica_max_ongoing_requests: 128
proxy_config:
  backend_port: 8000
  num_workers: 1
  options:
    balance: leastconn
    maxconn: 100000
  port: 4001
  python_path: /home/wenyiw/agpt/venv/litellm/bin/python3
  type: haproxy
ray_cluster_config:
  head_ip: $HEAD_IP
  node_cpus: 64
  port: 6379
YAML

echo "Config written to $DEBUG_OUT/config.yaml"

# --- Phase 1: Launch cluster ---
echo ""
echo "=== PHASE 1: LAUNCHING CLUSTER ==="
echo "Time: $(date -u)"

# launch_cluster.sh blocks until the cluster shuts down, so we run it in the
# background and capture its PID. The script's head node logic prints
# "[Driver] ALL SERVICES READY" when the cluster is live.
export EXASERVE_RUN_LOG_DIR="$DEBUG_OUT/run_logs"
export EXASERVE_RUN_LOG_FILE="$DEBUG_OUT/run_logs/launch.log"
export EXASERVE_DEBUG_HOLD_ON_FAILURE_S=300
mkdir -p "$DEBUG_OUT/run_logs"

bash src/exaserve/resources/launch_cluster.sh "$DEBUG_OUT/config.yaml" &
CLUSTER_PID=$!
echo "Cluster launcher PID: $CLUSTER_PID"

# Wait for "ALL SERVICES READY" marker in launch.log
READY_TIMEOUT=2400  # 40 min max
ELAPSED=0
READY=false
while [ $ELAPSED -lt $READY_TIMEOUT ]; do
    if [ -f "$DEBUG_OUT/run_logs/launch.log" ] && grep -q "ALL SERVICES READY" "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null; then
        READY=true
        break
    fi
    # Check if launcher died
    if ! kill -0 $CLUSTER_PID 2>/dev/null; then
        echo "FATAL: Cluster launcher exited before readiness."
        echo "Last 50 lines of launch.log:"
        tail -50 "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null
        wait $CLUSTER_PID || true
        exit 1
    fi
    sleep 10
    ELAPSED=$((ELAPSED + 10))
    if [ $((ELAPSED % 60)) -eq 0 ]; then
        echo "  Waiting for cluster... ${ELAPSED}s elapsed"
    fi
done

if [ "$READY" != "true" ]; then
    echo "FATAL: Cluster did not become ready within ${READY_TIMEOUT}s"
    tail -100 "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null
    kill $CLUSTER_PID 2>/dev/null || true
    wait $CLUSTER_PID 2>/dev/null || true
    exit 1
fi

echo ""
echo "=== PHASE 2: CLUSTER READY — RUNNING DIAGNOSTICS ==="
echo "Time: $(date -u)"

# --- Phase 2: Diagnostics ---

# 2a. Count ProxyActor deaths so far
PROXY_DEATHS_INITIAL=$(grep -c "class_name: ProxyActor" "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null || true)
PROXY_DEATHS_INITIAL=${PROXY_DEATHS_INITIAL:-0}
echo "ProxyActor deaths at readiness: $PROXY_DEATHS_INITIAL"

# 2b. Check HTTP proxy health on all nodes
echo ""
echo "--- Checking port 8000 health on all $NODE_COUNT nodes ---"
HEALTHY=0
UNHEALTHY=0
DOWN=0
while read -r node; do
    hsn="${node%%.*}"
    status=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 3 --max-time 5 "http://${hsn}.hsn.cm.aurora.alcf.anl.gov:8000/health" 2>/dev/null || echo "000")
    if [ "$status" = "200" ]; then
        HEALTHY=$((HEALTHY + 1))
    elif [ "$status" = "000" ]; then
        DOWN=$((DOWN + 1))
        echo "  DOWN: $hsn (connection failed)" | tee -a "$DEBUG_OUT/unhealthy_nodes.txt"
    else
        UNHEALTHY=$((UNHEALTHY + 1))
        echo "  UNHEALTHY: $hsn (HTTP $status)" | tee -a "$DEBUG_OUT/unhealthy_nodes.txt"
    fi
done < "$DEBUG_OUT/nodes.txt"
echo "Proxy health: Healthy=$HEALTHY Unhealthy=$UNHEALTHY Down=$DOWN / $NODE_COUNT"
echo "proxy_health_initial: healthy=$HEALTHY unhealthy=$UNHEALTHY down=$DOWN total=$NODE_COUNT" > "$DEBUG_OUT/health_summary.txt"

# 2c. Test a single inference request via HAProxy
echo ""
echo "--- Testing inference via HAProxy (port 4001) ---"
CURL_RESULT=$(curl -s -w "\nHTTP_CODE:%{http_code}\nTIME_TOTAL:%{time_total}" \
    --connect-timeout 10 --max-time 30 \
    -X POST "http://0.0.0.0:4001/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -d '{"model":"meta-llama/Meta-Llama-3-8B-Instruct","messages":[{"role":"user","content":"Say hello"}],"max_tokens":16}' \
    2>/dev/null || echo "CURL_FAILED")
echo "$CURL_RESULT" | tee "$DEBUG_OUT/haproxy_test.txt"

# 2d. Test direct mode — pick 3 random nodes
echo ""
echo "--- Testing direct inference on 3 random nodes ---"
shuf -n 3 "$DEBUG_OUT/nodes.txt" | while read -r node; do
    hsn="${node%%.*}.hsn.cm.aurora.alcf.anl.gov"
    echo "  Testing $hsn:8000..."
    result=$(curl -s -w "\n  HTTP:%{http_code} Time:%{time_total}s" \
        --connect-timeout 5 --max-time 30 \
        -X POST "http://${hsn}:8000/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d '{"model":"meta-llama/Meta-Llama-3-8B-Instruct","messages":[{"role":"user","content":"Say hello"}],"max_tokens":16}' \
        2>/dev/null || echo "  FAILED")
    echo "$result"
done | tee "$DEBUG_OUT/direct_test.txt"

# 2e. Wait 2 minutes and re-check for ProxyActor death progression
echo ""
echo "--- Monitoring ProxyActor stability for 120s ---"
for i in 30 60 90 120; do
    sleep 30
    deaths=$(grep -c "class_name: ProxyActor" "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null || true)
    deaths=${deaths:-0}
    down_count=$(grep "Server.*is DOWN" "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null | grep -oP '\d+ active' | tail -1 || true)
    down_count=${down_count:-N/A}
    echo "  t+${i}s: ProxyActor deaths=$deaths, HAProxy active=$down_count"
done

# 2f. Re-check node health after the wait
echo ""
echo "--- Re-checking port 8000 health after 2min ---"
HEALTHY2=0
DOWN2=0
while read -r node; do
    hsn="${node%%.*}"
    status=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 3 --max-time 5 "http://${hsn}.hsn.cm.aurora.alcf.anl.gov:8000/health" 2>/dev/null || echo "000")
    if [ "$status" = "200" ]; then
        HEALTHY2=$((HEALTHY2 + 1))
    else
        DOWN2=$((DOWN2 + 1))
    fi
done < "$DEBUG_OUT/nodes.txt"
echo "Proxy health after 2min: Healthy=$HEALTHY2 Down=$DOWN2 / $NODE_COUNT"
echo "proxy_health_2min: healthy=$HEALTHY2 down=$DOWN2 total=$NODE_COUNT" >> "$DEBUG_OUT/health_summary.txt"

# 2g. Collect resource usage on head node
echo ""
echo "--- Head node resource usage ---"
free -h | tee "$DEBUG_OUT/head_memory.txt"
echo ""
echo "Process count: $(ps aux | wc -l)"
echo "Ray processes: $(ps aux | grep -c '[r]ay')"
echo "Python processes: $(ps aux | grep -c '[p]ython')"

# 2h. Final ProxyActor death count
PROXY_DEATHS_FINAL=$(grep -c "class_name: ProxyActor" "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null || true)
PROXY_DEATHS_FINAL=${PROXY_DEATHS_FINAL:-0}
echo ""
echo "=== FINAL SUMMARY ==="
echo "ProxyActor deaths: initial=$PROXY_DEATHS_INITIAL final=$PROXY_DEATHS_FINAL"
echo "Proxy health: initial=$HEALTHY/$NODE_COUNT final=$HEALTHY2/$NODE_COUNT"
TIMEOUT_PATCH=$(grep -c 'HTTP_PROXY_TIMEOUT' "$DEBUG_OUT/run_logs/launch.log" 2>/dev/null || true)
echo "HTTP_PROXY_TIMEOUT patch applied: ${TIMEOUT_PATCH:-unknown}"
echo ""
echo "Results saved to: $DEBUG_OUT"
echo "Launch log: $DEBUG_OUT/run_logs/launch.log"

# --- Cleanup ---
echo ""
echo "=== SHUTTING DOWN CLUSTER ==="
kill $CLUSTER_PID 2>/dev/null || true
wait $CLUSTER_PID 2>/dev/null || true
echo "Done. Time: $(date -u)"
