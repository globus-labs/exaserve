#!/bin/bash
#PBS -l select=128
#PBS -l walltime=01:00:00
#PBS -q debug-scaling
#PBS -l filesystems=home:flare
#PBS -A AuroraGPT
#PBS -N debug-sleep128
#PBS -l place=scatter
#PBS -o /home/wenyiw/exaserve/tmp/debug-sleep128.stdout
#PBS -e /home/wenyiw/exaserve/tmp/debug-sleep128.stderr
echo "NODE=$(hostname)"
echo "JOBID=$PBS_JOBID"
cp "$PBS_NODEFILE" "$HOME/.exaserve_nodefile.$PBS_JOBID"
echo "NODEFILE=$HOME/.exaserve_nodefile.$PBS_JOBID"
echo "NODES=$(sort -u "$PBS_NODEFILE" | wc -l)"
sleep 3500
