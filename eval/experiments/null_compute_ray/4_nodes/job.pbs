#!/bin/bash -l
#PBS -N null_compute_ray_4n
#PBS -m bae
#PBS -M wenyiw@uchicago.edu
#PBS -l filesystems=home:flare
#PBS -A AuroraGPT
#PBS -k doe
#PBS -l select=4
#PBS -l walltime=1:00:00
#PBS -q debug-scaling
#PBS -o /lus/flare/projects/AuroraGPT/wenyiw/data/pbs_output/null_compute_ray/4_nodes/stdout/
#PBS -e /lus/flare/projects/AuroraGPT/wenyiw/data/pbs_output/null_compute_ray/4_nodes/stderr/

# Navigate to Experiment Directory
cd /home/wenyiw/aurora_rayserver/eval/experiments/null_compute_ray/4_nodes

echo "=================================================="
echo "PBS Job Information"
echo "=================================================="
echo "Job ID:     $PBS_JOBID"
echo "Job Name:   null_compute_ray_4n"
echo "Hostname:   $(hostname)"
echo "Nodes:      4"
echo "Backend:    ray"
echo "Work Dir:   $(pwd)"
echo "Config:     /home/wenyiw/aurora_rayserver/eval/experiments/null_compute_ray/4_nodes/config.yaml"
echo "=================================================="

export AURORA_NULL_COMPUTE=1
# Invoke Experiment Driver (using absolute path) with backend specification
bash "/home/wenyiw/aurora_rayserver/eval/templates/run_exp.sh" /home/wenyiw/aurora_rayserver/eval/experiments/null_compute_ray/4_nodes/config.yaml --backend ray  --num-runs 3
