# Navigate to Experiment Directory
cd /home/wenyiw/aurora_rayserver/eval/experiments/weak_scaling_ray_2/512_nodes

echo "=================================================="
echo "PBS Job Information"
echo "=================================================="
echo "Job ID:     $PBS_JOBID"
echo "Job Name:   weak_scaling_ray_2_512n"
echo "Hostname:   $(hostname)"
echo "Nodes:      512"
echo "Backend:    ray"
echo "Work Dir:   $(pwd)"
echo "Config:     /home/wenyiw/aurora_rayserver/eval/experiments/weak_scaling_ray_2/512_nodes/config.yaml"
echo "=================================================="


# Invoke Experiment Driver (using absolute path) with backend specification
bash "/home/wenyiw/aurora_rayserver/eval/templates/run_exp.sh" /home/wenyiw/aurora_rayserver/eval/experiments/weak_scaling_ray_2/512_nodes/config.yaml --backend ray  --num-runs 3
