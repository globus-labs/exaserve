# Project-wide matplotlib theme for Aurora Ray Serve eval plots.
# Loaded explicitly via eval/plot/plotstyle.py (apply()), so it applies
# regardless of CWD. Per-series colour/marker/linestyle choices live in
# plotstyle.py; this file is global look-and-feel only.
#
# BASIS: this theme adopts the lab convention from eval/plot/yadusmatplotlibrc
# (small fonts, thin lines, dotted grid, tight PDF output) so figures are
# authored at their FINAL physical size and rendered 1:1 in the paper (no
# down-scaling). Figures are sized to the IEEE column (~3.4in) or text width
# (~7in) in sc26_full_figures.py to match.
#
# PROJECT DEVIATIONS from yadusmatplotlibrc (adjust freely):
#   * fonts: Yadu uses a uniform 6pt; titles/labels bumped to 7pt (ticks/legend
#     stay 6pt) for print legibility on these dense multi-panel figures.
#   * spines top/right off + light axes face: project polish; Yadu is silent
#     (matplotlib default = all spines on, white face). Set back for strict Yadu.
#   * per-proxy colours come from plotstyle.PROXY_COLORS (Dark2), not the cycle
#     below; the cycle is only the fallback for non-proxy plots.

# ---- fonts (lab convention: small + consistent) ----
# Times-matching SERIF to match the IEEEtran (Times) body font, per
# duetosymmetry.com/code/latex-mpl-fig-tips. STIX is Times-metric-compatible and
# bundled with matplotlib, so we get the LaTeX-font look WITHOUT text.usetex
# (which would choke on the Unicode ∈ ≤ → · ± in our labels).
font.family           : serif
font.serif            : STIXGeneral, STIX, Times New Roman, Nimbus Roman, DejaVu Serif
mathtext.fontset      : stix
font.size             : 7
axes.titlesize        : 7
axes.titleweight      : bold
axes.labelsize        : 7
axes.labelweight      : bold
xtick.labelsize       : 6
ytick.labelsize       : 6
legend.fontsize       : 6
legend.title_fontsize : 6
figure.titlesize      : 8
figure.titleweight    : bold
figure.labelsize      : 7

# ---- axes ----
axes.linewidth        : 0.5
axes.titlepad         : 2.0
axes.facecolor        : white
axes.edgecolor        : 444444
axes.labelcolor       : 222222
axes.titlecolor       : 1a1a1a
axes.grid             : True
axes.grid.axis        : both
axes.axisbelow        : True
axes.spines.top       : False
axes.spines.right     : False
axes.prop_cycle       : cycler('color', ['4D3886', '11A579', 'D64269', 'F2B701', '3969AC', 'E68310'])

# ---- grid (Yadu: subtle dotted) ----
grid.color            : DFDFDF
grid.linestyle        : :
grid.linewidth        : 0.5
grid.alpha            : 1.0

# ---- ticks (Yadu sizes) ----
xtick.major.width     : 0.5
xtick.minor.width     : 0.5
ytick.major.width     : 0.5
ytick.minor.width     : 0.5
xtick.major.size      : 2
xtick.minor.size      : 2
ytick.major.size      : 2
ytick.minor.size      : 2

# ---- lines / markers (thin, lab convention) ----
lines.linewidth       : 1.1
lines.markersize      : 4
lines.markeredgewidth : 0.5
lines.markeredgecolor : white

# ---- legend ----
legend.frameon        : True
legend.fancybox       : False
legend.framealpha     : 0.92
legend.edgecolor      : CCCCCC
legend.facecolor      : white
legend.borderpad      : 0.3
legend.labelspacing   : 0.3
legend.handlelength   : 1.6

# ---- figure / save (Yadu: tight PDF, high dpi) ----
figure.facecolor      : white
figure.dpi            : 200
savefig.dpi           : 400
savefig.facecolor     : white
savefig.format        : pdf
savefig.bbox          : tight
savefig.pad_inches    : 0.04
pdf.fonttype          : 42
ps.fonttype           : 42
