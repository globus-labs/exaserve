# Project-wide matplotlib theme for Aurora Ray Serve eval plots.
# Loaded explicitly via eval/plot/plotstyle.py (apply()), so it applies
# regardless of CWD. Keep all per-series colour/marker/linestyle choices in
# plotstyle.py — this file is global look-and-feel only.

# ---- figure / save ----
figure.facecolor      : white
figure.dpi            : 110
savefig.dpi           : 130
savefig.facecolor     : white
savefig.bbox          : tight

# ---- fonts ----
font.size             : 11
axes.titlesize        : 13
axes.titleweight      : bold
axes.labelsize        : 12
axes.labelweight      : bold
xtick.labelsize       : 11
ytick.labelsize       : 11
legend.fontsize       : 9
figure.titlesize      : 15
figure.titleweight    : bold

# ---- axes ----
axes.facecolor        : FAFAFA
axes.edgecolor        : DDDDDD
axes.linewidth        : 1.2
axes.labelcolor       : 333333
axes.titlecolor       : 1a1a1a
axes.grid             : True
axes.axisbelow        : True
axes.spines.top       : False
axes.spines.right     : False
axes.prop_cycle       : cycler('color', ['1b9e77', 'd95f02', '7570b3', 'e7298a', '66a61e', 'e6ab02', 'a6761d'])

# ---- grid ----
grid.color            : CCCCCC
grid.linestyle        : --
grid.linewidth        : 0.8
grid.alpha            : 0.4

# ---- lines / markers ----
lines.linewidth       : 2.6
lines.markersize      : 9
lines.markeredgewidth : 1.8
lines.markeredgecolor : white

# ---- legend ----
legend.frameon        : True
legend.fancybox       : True
legend.shadow         : True
legend.framealpha     : 0.95
legend.edgecolor      : CCCCCC
legend.facecolor      : white
